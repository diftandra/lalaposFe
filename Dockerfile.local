# Build the Angular app and serve it with nginx.
# Angular 13 requires Node 16.
#
# Optional corporate proxy support (leave empty when not behind a proxy):
#   docker build -f Dockerfile.local \
#     --build-arg HTTP_PROXY=http://your-proxy:8080 \
#     --build-arg HTTPS_PROXY=http://your-proxy:8080 -t lalapos-fe .
FROM node:16-alpine AS angular-build
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
WORKDIR /app

# Configure npm proxy only if build args were provided.
RUN if [ -n "$HTTP_PROXY" ]; then npm config set proxy "$HTTP_PROXY"; fi \
 && if [ -n "$HTTPS_PROXY" ]; then npm config set https-proxy "$HTTPS_PROXY"; fi

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build -- --configuration production

FROM nginxinc/nginx-unprivileged
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=angular-build /app/dist/lala-pos/ /usr/share/nginx/html
